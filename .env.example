# Warehouse access
APP_PASSWORD=change-me
AUTH_SECRET=change-this-secret

# Optional named users. If omitted, login "admin" uses APP_PASSWORD.
# Roles: admin | manager | storekeeper | viewer
WAREHOUSE_USERS=[{"username":"admin","name":"Администратор","password":"change-me","role":"admin"},{"username":"manager","name":"Заведующий складом","password":"change-me","role":"manager"},{"username":"storekeeper","name":"Кладовщик","password":"change-me","role":"storekeeper"},{"username":"viewer","name":"Просмотр","password":"change-me","role":"viewer"}]

# Database: keep the variables already used by your local/production db/index.ts configuration.

# Production protection / circuit breaker.
# Small pool + short timeouts prevent a failing PostgreSQL from exhausting the DB.
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_MS=1500
DB_STATEMENT_TIMEOUT_MS=2500
DB_QUERY_TIMEOUT_MS=3000
DB_CIRCUIT_FAILURE_THRESHOLD=1
DB_CIRCUIT_COOLDOWN_MS=60000
DB_SYNC_INTERVAL_MS=60000
DB_SYNC_BATCH_SIZE=5
